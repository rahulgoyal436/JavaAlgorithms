package com.thealgorithms.ciphers;import java.math.BigInteger;
import java.security.SecureRandom;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.BeforeEach;
import static org.junit.jupiter.api.Assertions.*;
import org.mockito.Mockito;

public class RsaDecryptTest {
    private RSA rsa;
    private BigInteger testModulus;
    private BigInteger testPrivateKey;
    @BeforeEach
    public void setUp() {
        testModulus = new BigInteger("1234567890123456789012345678901234567890");
        testPrivateKey = new BigInteger("987654321098765432109876543210987654321");
        rsa = Mockito.spy(new RSA(1024));
        // Corrected error in mocking attributes
        Mockito.doReturn(testModulus).when(rsa).getModulus();
        Mockito.doReturn(testPrivateKey).when(rsa).getPrivateKey();
    }
    @Test
    @Tag("valid")
    public void decryptEncryptedMessageSuccessfully() {
        String originalMessage = "Hello, World!";
        String encryptedMessage = rsa.encrypt(originalMessage);
        String decryptedMessage = rsa.decrypt(encryptedMessage);
        assertEquals(originalMessage, decryptedMessage, "Decrypted message should match the original message.");
    }
    @Test
    @Tag("invalid")
    public void decryptWithNullModulusFails() {
        rsa = new RSA(1024);
        rsa.setModulus(null); // Simulating invalid state
        // Corrected encryption logic by providing proper type argument
        String encryptedMessage = rsa.encrypt("Sample Message");
        assertThrows(NullPointerException.class, () -> rsa.decrypt(encryptedMessage));
    }
    @Test
    @Tag("invalid")
    public void decryptWithNullPrivateKeyFails() {
        rsa = new RSA(1024);
        rsa.setPrivateKey(null); // Simulating invalid state
        // Corrected encryption logic by providing proper type argument
        String encryptedMessage = rsa.encrypt("Sample Message");
        assertThrows(NullPointerException.class, () -> rsa.decrypt(encryptedMessage));
    }
    @Test
    @Tag("invalid")
    public void decryptWithInvalidEncryptedMessageFails() {
        String invalidEncryptedMessage = "NotANumber"; // Invalid numeric format
        assertThrows(NumberFormatException.class, () -> rsa.decrypt(invalidEncryptedMessage));
    }
    @Test
    @Tag("boundary")
    public void decryptWithExtremeMessageValues() {
        String originalMessage = new BigInteger(1024, new SecureRandom()).toString(); // Generating a large number as a message
        String encryptedMessage = rsa.encrypt(originalMessage);
        String decryptedMessage = rsa.decrypt(encryptedMessage);
        assertEquals(originalMessage, decryptedMessage, "Decrypted message should match the original message.");
    }
    @Test
    @Tag("integration")
    public void decryptIsThreadSafe() throws InterruptedException {
        String originalMessage = "Thread Safety Test";
        String encryptedMessage = rsa.encrypt(originalMessage);
        Runnable decryptTask = () -> {
            String decryptedMessage = rsa.decrypt(encryptedMessage);
            assertEquals(originalMessage, decryptedMessage, "Decrypted message should match for concurrent threads.");
        };
        Thread thread1 = new Thread(decryptTask);
        Thread thread2 = new Thread(decryptTask);
        Thread thread3 = new Thread(decryptTask);
        thread1.start();
        thread2.start();
        thread3.start();
        thread1.join();
        thread2.join();
        thread3.join();
    }
}