package com.thealgorithms.ciphers.a5;
import java.util.BitSet;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import static org.assertj.core.api.Assertions.assertThat;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;

class A5CipherEncryptTest {
    private A5Cipher a5Cipher;
    private A5KeyStreamGenerator keyStreamGenerator;
    @BeforeEach
    void setUp() {
        BitSet sessionKey = new BitSet(64);
        BitSet frameCounter = new BitSet(22);
        keyStreamGenerator = mock(A5KeyStreamGenerator.class);
        a5Cipher = new A5Cipher(sessionKey, frameCounter);
        a5Cipher.setKeyStreamGenerator(keyStreamGenerator);
    }
    @Test
    @Tag("valid")
    void encryptAllBitsZero() {
        BitSet plainTextBits = new BitSet(228);
        BitSet keyStream = new BitSet(228);
        keyStream.set(0, 228, true);
        when(keyStreamGenerator.getNextKeyStream()).thenReturn(keyStream);
        BitSet result = a5Cipher.encrypt(plainTextBits);
        assertThat(result).isEqualTo(keyStream);
    }
    @Test
    @Tag("valid")
    void encryptAllBitsOne() {
        BitSet plainTextBits = new BitSet(228);
        plainTextBits.set(0, 228, true);
        BitSet keyStream = new BitSet(228);
        keyStream.set(0, 228, true);
        when(keyStreamGenerator.getNextKeyStream()).thenReturn(keyStream);
        BitSet result = a5Cipher.encrypt(plainTextBits);
        assertThat(result).isEqualTo(new BitSet(228));
    }
    @Test
    @Tag("valid")
    void encryptRandomBits() {
        BitSet plainTextBits = new BitSet(228);
        plainTextBits.set(0, 228, true);
        plainTextBits.flip(100);
        BitSet keyStream = new BitSet(228);
        keyStream.set(0, 228, true);
        when(keyStreamGenerator.getNextKeyStream()).thenReturn(keyStream);
        BitSet result = a5Cipher.encrypt(plainTextBits);
        BitSet expected = new BitSet(228);
        expected.set(0, 228, true);
        expected.flip(100);
        assertThat(result).isEqualTo(expected);
    }
    @Test
    @Tag("invalid")
    void encryptEmptyBitSet() {
        BitSet plainTextBits = new BitSet();
        BitSet keyStream = new BitSet(228);
        keyStream.set(0, 228, true);
        when(keyStreamGenerator.getNextKeyStream()).thenReturn(keyStream);
        BitSet result = a5Cipher.encrypt(plainTextBits);
        assertThat(result).isEqualTo(new BitSet(228));
    }
    @Test
    @Tag("boundary")
    void encryptBitSetLessThanKeyStreamLength() {
        BitSet plainTextBits = new BitSet(100);
        plainTextBits.set(0, 100, true);
        BitSet keyStream = new BitSet(228);
        keyStream.set(0, 228, true);
        when(keyStreamGenerator.getNextKeyStream()).thenReturn(keyStream);
        BitSet result = a5Cipher.encrypt(plainTextBits);
        BitSet expected = new BitSet(228);
        expected.set(0, 100, true);
        expected.xor(keyStream);
        assertThat(result).isEqualTo(expected);
    }
    @Test
    @Tag("boundary")
    void encryptBitSetGreaterThanKeyStreamLength() {
        BitSet plainTextBits = new BitSet(300);
        plainTextBits.set(0, 300, true);
        BitSet keyStream = new BitSet(228);
        keyStream.set(0, 228, true);
        when(keyStreamGenerator.getNextKeyStream()).thenReturn(keyStream);
        BitSet result = a5Cipher.encrypt(plainTextBits);
        BitSet expected = new BitSet(228);
        expected.set(0, 228, true);
        expected.xor(keyStream);
        assertThat(result).isEqualTo(expected);
    }
    @Test
    @Tag("invalid")
    void encryptNullKeyStream() {
        BitSet plainTextBits = new BitSet(228);
        plainTextBits.set(0, 228, true);
        when(keyStreamGenerator.getNextKeyStream()).thenReturn(null);
        BitSet result = a5Cipher.encrypt(plainTextBits);
        assertThat(result).isEqualTo(plainTextBits);
    }
    @Test
    @Tag("invalid")
    void encryptKeyStreamDifferentLength() {
        BitSet plainTextBits = new BitSet(228);
        plainTextBits.set(0, 228, true);
        BitSet keyStream = new BitSet(100);
        keyStream.set(0, 100, true);
        when(keyStreamGenerator.getNextKeyStream()).thenReturn(keyStream);
        BitSet result = a5Cipher.encrypt(plainTextBits);
        BitSet expected = new BitSet(228);
        expected.set(0, 100, true);
        expected.xor(keyStream);
        assertThat(result).isEqualTo(expected);
    }
}