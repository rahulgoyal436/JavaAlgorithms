package com.thealgorithms.ciphers;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockedStatic;
import org.mockito.Mockito;
import org.mockito.junit.jupiter.MockitoExtension;
import java.io.ByteArrayInputStream;
import java.io.ByteArrayOutputStream;
import java.io.PrintStream;
import java.util.Scanner;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.Mockito.when;
import org.junit.jupiter.api.*;

@ExtendWith(MockitoExtension.class)
public class HillCipherDecryptTest {
    @Mock
    private Scanner mockScanner;
    @InjectMocks
    private HillCipher hillCipher;
    private final ByteArrayOutputStream outContent = new ByteArrayOutputStream();
    private final PrintStream originalOut = System.out;
    @BeforeEach
    public void setUpStreams() {
        System.setOut(new PrintStream(outContent));
    }
    @AfterEach
    public void restoreStreams() {
        System.setOut(originalOut);
    }
    @Test
    @Tag("valid")
    public void decryptSimpleMessageWith2x2KeyMatrix() {
        try (MockedStatic<Scanner> mockedScanner = Mockito.mockStatic(Scanner.class)) {
            mockedScanner.when(() -> Scanner.class.getDeclaredConstructor(InputStream.class))
                    .thenReturn(mockScanner);
            when(mockScanner.nextInt()).thenReturn(2, 3, 1, 1, 2, 3);
            when(mockScanner.nextLine()).thenReturn("HELLO");
            HillCipher.decrypt("KHOOR");
            assertEquals("HELLO", outContent.toString().trim().split(" ")[1]);
        }
    }
    @Test
    @Tag("valid")
    public void decryptMessageWith3x3KeyMatrix() {
        try (MockedStatic<Scanner> mockedScanner = Mockito.mockStatic(Scanner.class)) {
            mockedScanner.when(() -> Scanner.class.getDeclaredConstructor(InputStream.class))
                    .thenReturn(mockScanner);
            when(mockScanner.nextInt()).thenReturn(3, 3, 1, 2, 2, 2, 1, 1, 2, 1, 2, 3);
            when(mockScanner.nextLine()).thenReturn("HELLO");
            HillCipher.decrypt("KHOORZ");
            assertEquals("HELLO", outContent.toString().trim().split(" ")[1]);
        }
    }
    @Test
    @Tag("invalid")
    public void decryptMessageWithNonInvertibleKeyMatrix() {
        try (MockedStatic<Scanner> mockedScanner = Mockito.mockStatic(Scanner.class)) {
            mockedScanner.when(() -> Scanner.class.getDeclaredConstructor(InputStream.class))
                    .thenReturn(mockScanner);
            when(mockScanner.nextInt()).thenReturn(2, 1, 2, 3, 4);
            when(mockScanner.nextLine()).thenReturn("HELLO");
            HillCipher.decrypt("KHOOR");
            assertEquals("Exception: Key matrix is not invertible", outContent.toString().trim().split(" ")[1]);
        }
    }
