    @Tag("valid")
    public void decryptValidEncryptedMessage() {
        String plainMessage = "12345";
        BigInteger encryptedMessage = rsa.encrypt(new BigInteger(plainMessage));
        BigInteger decryptedMessage = rsa.decrypt(encryptedMessage);
        assertEquals(new BigInteger(plainMessage), decryptedMessage, "Decrypted message does not match original plain message.");
    }
