package com.thealgorithms.ciphers;import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.assertj.core.api.Assertions;
import java.math.BigInteger;
import org.junit.jupiter.api.*;
import java.security.SecureRandom;

public class RsaEncrypt731Test {
    @Test
    @Tag("valid")
    public void encryptPositiveBigIntegerWithValidKeys() {
        // Arrange
        BigInteger message = new BigInteger("12345");
        RSA rsa = new RSA(512); // Initialize with appropriate bit size
        // Private access fields are already initialized in the constructor and `generateKeys` method is called inside constructor.
        // Act
        BigInteger result = rsa.encrypt(message);
        // Assert
        Assertions.assertThat(result).isEqualTo(message.modPow(rsa.publicKey, rsa.modulus)); // Expect public keys and modulus generated in the object.
    }
    @Test
    @Tag("invalid")
    public void encryptNullBigIntegerMessage() {
        // Arrange
        RSA rsa = new RSA(512); // Initialize with appropriate bit size
        // Ensure private keys and modulus are initialized by constructor
        
        // Act & Assert
        Assertions.assertThatThrownBy(() -> rsa.encrypt(null))
                  .isInstanceOf(NullPointerException.class);
    }
    @Test
    @Tag("boundary")
    public void encryptZeroBigIntegerMessage() {
        // Arrange
        BigInteger message = BigInteger.ZERO;
        RSA rsa = new RSA(512); // Initialize with appropriate bit size
        // Ensure private keys and modulus are initialized
        
        // Act
        BigInteger result = rsa.encrypt(message);
        // Assert
        Assertions.assertThat(result).isEqualTo(message.modPow(rsa.publicKey, rsa.modulus));
    }
    @Test
    @Tag("boundary")
    public void encryptMaxBigIntegerMessage() {
        // Arrange
        BigInteger message = BigInteger.valueOf(Long.MAX_VALUE);
        RSA rsa = new RSA(512); // Initialize with appropriate bit size
        // Ensure private keys and modulus are initialized
        
        // Act
        BigInteger result = rsa.encrypt(message);
        // Assert
        Assertions.assertThat(result).isEqualTo(message.modPow(rsa.publicKey, rsa.modulus));
    }
    
    @Test
    @Tag("integration")
    public void encryptWithRealRsaValues() {
        // Arrange
        RSA rsa = new RSA(512); // Initialize with 512-bit key. Ensure constructor calls generateKeys and initializes fields.
        BigInteger message = new BigInteger("123456789");
        
        // Act
        BigInteger result = rsa.encrypt(message);
        
        // Assert
        Assertions.assertThat(result).isNotNull();
        Assertions.assertThat(result).isGreaterThan(BigInteger.ZERO);
    }
